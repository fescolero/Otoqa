# Otoqa Driver — client config, COMMITTED on purpose.
#
# Every value here is EXPO_PUBLIC_* — public client-side config that ships
# inside every JS bundle anyway (Convex URL, Clerk publishable key, PostHog
# project key). They are already committed in eas.json's build profiles;
# this file exists because `eas update` does NOT read those.
#
# Without it, an OTA bundle is built with these undefined, and both
# lib/convex.tsx and app/_layout.tsx throw at MODULE SCOPE — so the bundle
# dies at launch, expo-updates rolls back to the embedded build, and the
# app restarts into the same pending update. That reads as "the OTA never
# applied", or as a frozen screen. Same failure the dispatch app hit; see
# 8777b34 fix(dispatch): commit public client .env.
#
# NOT here: EXPO_PUBLIC_MOBILE_LOCATION_API_KEY. It is a sensitive EAS
# environment variable and must stay one. Publish with
# `eas update --environment preview` so EAS injects it — a bundle without
# it launches fine but throws on every GPS upload.
#
# .env.local (gitignored) still overrides for local experiments.

EXPO_PUBLIC_CONVEX_URL=https://greedy-vole-262.convex.cloud
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Z2xvd2luZy1zaGVlcGRvZy05Ny5jbGVyay5hY2NvdW50cy5kZXYk

# PostHog (D17/D18) — shared project with the dispatch app; the `app`
# super-property separates them.
EXPO_PUBLIC_POSTHOG_KEY=phc_PZ3GNbNMNfasjq93uuEzrw9vQABLHfe4OFxm4H7Sg6X
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
