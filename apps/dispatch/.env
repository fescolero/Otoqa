# Otoqa Dispatch — client config, COMMITTED on purpose.
#
# Every value here is EXPO_PUBLIC_* — public client-side config that ships
# inside every JS bundle anyway (Convex URL, Clerk publishable key, WorkOS
# client id). Committing it means `eas update` bundles the right config no
# matter which machine publishes; a missing .env.local used to produce
# bundles with no Convex URL that crashed at startup and silently rolled
# back, looking like "the OTA never applied".
#
# .env.local (gitignored) still overrides for local experiments.

EXPO_PUBLIC_CONVEX_URL=https://greedy-vole-262.convex.cloud
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Z2xvd2luZy1zaGVlcGRvZy05Ny5jbGVyay5hY2NvdW50cy5kZXYk

# WorkOS AuthKit (staff Google Workspace SSO). Must match the Convex
# deployment's WORKOS_CLIENT_ID; otoqa-dispatch://sso must be allowlisted.
EXPO_PUBLIC_WORKOS_CLIENT_ID=client_01KAETKWFMGC6VEVXXB51A40QC

# PostHog (D17/D18) — shared project with the driver app; the `app`
# super-property separates them.
EXPO_PUBLIC_POSTHOG_KEY=phc_PZ3GNbNMNfasjq93uuEzrw9vQABLHfe4OFxm4H7Sg6X
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
