{
  "expo": {
    "name": "Otoqa Dispatch",
    "slug": "otoqa-dispatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "otoqa-dispatch",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.otoqa.dispatch",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.otoqa.dispatch"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-updates",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Otoqa Dispatch uses the microphone for voice commands like assigning loads and moving appointments.",
          "speechRecognitionPermission": "Otoqa Dispatch uses speech recognition to understand your voice commands."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/ba5a70b6-1b02-4618-a217-6d1942af4245"
    },
    "extra": {
      "eas": {
        "projectId": "ba5a70b6-1b02-4618-a217-6d1942af4245"
      }
    }
  }
}
