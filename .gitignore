# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
# dispatch app env is public EXPO_PUBLIC_* client config, committed so
# eas update bundles it from any machine (see the file's header comment)
!apps/dispatch/.env
# Same reasoning for the driver app — see the header in the file itself.
!apps/driver/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local ops logs (not for the repo)
scripts/autofix-log.md

# Solver test data (contains real customer lane data)
scripts/entries.json

# Internal documentation (keep only README.md and convex/README.md)
/docs/
/*_COMPLETE.md
/*_GUIDE.md
/*_STATUS.md
/*_PROGRESS.md
/*_SUMMARY.md
/*_REVIEW.md
/*_FIX.md
/*_ANALYSIS.md
/*_GUIDANCE.md
/*_SETUP.md
/*_ENGINE.md
/*_MIGRATION.md

# Claude Code session worktrees (local only)
.claude/worktrees/
apps/driver/.claude/

# Native module build output
apps/driver/modules/*/android/build/

# Next.js build output in workspace apps (root /.next/ is anchored)
apps/*/.next/

# Agent tooling installed per-machine (npx convex ai-files install,
# skills add). Regenerated on demand; the lockfile pins versions for
# whoever re-runs the install.
.agents/
.claude/skills/
skills-lock.json
convex/_generated/ai/
AGENTS.md
CLAUDE.md

# Stray native prebuild of the driver app (OtoqaDriver): ios/Pods,
# android/build, dist/, .expo/, node_modules and a .env — ~2.1G of
# generated output with no package.json and no JS source. The real app
# is apps/driver/. Safe to delete, not just ignore.
/mobile/
